<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================
  MH3 RENTAL — web.config  (IIS / Locaweb)
  Revisado em 27/07/2026 — auditoria do FTP
  ============================================================

  O QUE MUDOU EM RELACAO AO ANTERIOR

  1) BLOQUEIO DOS ARQUIVOS .txt  (novidade — o mais importante)
     Antes, qualquer pessoa podia digitar SEU-SITE/parte5.txt no navegador
     e BAIXAR o sistema inteiro, sem senha nenhuma. O mesmo valia para o
     recuperar_alocacao_veiculos.txt, que tem nome de cliente, placa,
     nome e celular de motorista.
     Agora o servidor devolve "nao encontrado" para qualquer .txt.
     O index.php CONTINUA funcionando: ele le os arquivos direto do disco,
     nao pela internet — esse bloqueio nao atrapalha em nada.
     Efeito colateral aceito: o robots.txt tambem para de responder. Nao faz
     falta, porque o cabecalho X-Robots-Tag ja manda os buscadores ignorarem
     o site.

  2) COMENTARIOS ANTIGOS REMOVIDOS
     O texto anterior falava de um "porteiro" (login.html) e de um
     sistema.html que nao existem mais. Ficava confuso na hora de mexer.

  O QUE FOI MANTIDO
     - A raiz do site abre o index.php.
     - A pasta /core/ continua escondida (acesso direto devolve 404).
     - Cabecalhos de seguranca e ocultacao do servidor.
     - CSP em modo "somente relatorio" (nao bloqueia nada ainda).

  SE O SITE DER "ERRO 500" DEPOIS DE SUBIR ESTE ARQUIVO
     Quer dizer que a Locaweb nao libera o bloco <fileExtensions> nesse plano.
     Nesse caso: apague as 7 linhas do bloco <fileExtensions>...</fileExtensions>
     (elas estao marcadas com "NOVO:" mais abaixo) e suba de novo.
     Todo o resto continua valendo. Guarde uma copia do web.config antigo
     antes de trocar, por seguranca.
-->
<configuration>
  <system.webServer>

    <!-- A raiz abre o index.php -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.php" />
        <add value="index.html" />
        <add value="Default.htm" />
      </files>
    </defaultDocument>

    <!-- Cabecalhos de seguranca em todas as respostas -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="geolocation=(), microphone=(), camera=(), payment=()" />
        <add name="Strict-Transport-Security" value="max-age=31536000" />
        <add name="Content-Security-Policy-Report-Only"
             value="default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'" />
      </customHeaders>
    </httpProtocol>

    <security>
      <requestFiltering removeServerHeader="true">
        <requestLimits maxAllowedContentLength="104857600" />

        <!-- Esconde a pasta /core/ do acesso direto -->
        <hiddenSegments>
          <add segment="core" />
        </hiddenSegments>

        <!-- NOVO: ninguem baixa .txt pela internet (protege parte1..parte5
             e qualquer arquivo de dados esquecido na pasta) -->
        <fileExtensions allowUnlisted="true">
          <add fileExtension=".txt" allowed="false" />
          <add fileExtension=".zip" allowed="false" />
          <add fileExtension=".bak" allowed="false" />
          <add fileExtension=".sql" allowed="false" />
          <add fileExtension=".log" allowed="false" />
        </fileExtensions>

      </requestFiltering>
    </security>

    <!--
      REDIRECIONAR HTTP -> HTTPS  (DESLIGADO por padrao)
      So funciona com o modulo "URL Rewrite" instalado. Para ativar, tire do comentario.

    <rewrite>
      <rules>
        <rule name="Forcar HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>
    -->

  </system.webServer>
</configuration>
