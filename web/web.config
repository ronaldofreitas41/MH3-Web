<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================
  MH3 RENTAL — web.config de SEGURANÇA (IIS / Locaweb)
  Correções: A4 (cabeçalhos), M6 (esconder servidor), B3 (HTTPS), C7 (porteiro)
  ============================================================

  ATENÇÃO — LEIA ANTES DE SUBIR:
  - Você confirmou que NÃO existe web.config no servidor: pode subir este.
  - Este web.config faz a "raiz decidir": dmsserv.com.br abre o index.php (porteiro).
  - O segmento /core/ fica ESCONDIDO (acesso direto a /core/app.html devolve 404),
    mas o porteiro (index.php) consegue ler o arquivo internamente. Isso impede que
    alguém baixe o app sem estar logado.
  - A CSP está em modo "somente relatório" (não bloqueia nada ainda).

  ROLLOUT EM ETAPAS (combinado):
    ETAPA 1 (agora): suba index.php, login.html, api.php, core/app.html e este web.config.
                     NÃO apague o sistema.html ainda. Teste o fluxo:
                       1) abra dmsserv.com.br  -> deve aparecer a tela de login
                       2) faça login            -> deve abrir o sistema
                       3) tente abrir dmsserv.com.br/core/app.html -> deve dar "não encontrado" (404)
                       4) saia (logout)         -> deve voltar para a tela de login
    ETAPA 2 (após o teste OK): apague o sistema.html antigo do servidor (ou me avise
                     que eu te passo a regra de bloqueio). Aí o acesso direto ao app some.
-->
<configuration>
  <system.webServer>

    <!-- [C7] A raiz abre o porteiro -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.php" />
        <add value="index.html" />
        <add value="Default.htm" />
      </files>
    </defaultDocument>

    <!-- [A4] Cabeçalhos de segurança em todas as respostas -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="geolocation=(), microphone=(), camera=(), payment=()" />
        <add name="Strict-Transport-Security" value="max-age=31536000" />
        <add name="Content-Security-Policy-Report-Only"
             value="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'" />
      </customHeaders>
    </httpProtocol>

    <!-- [M6] Esconde o cabeçalho do servidor + [C7] esconde a pasta /core/ do acesso direto -->
    <security>
      <requestFiltering removeServerHeader="true">
        <requestLimits maxAllowedContentLength="104857600" />
        <hiddenSegments>
          <add segment="core" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <!--
      [B3] REDIRECIONAR HTTP -> HTTPS  (DESLIGADO por padrão)
      Só funciona com o módulo "URL Rewrite" instalado. Para ativar, tire do comentário.

    <rewrite>
      <rules>
        <rule name="Forcar HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>
    -->

  </system.webServer>
</configuration>
